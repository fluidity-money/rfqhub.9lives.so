#!/usr/bin/env -S rc -e

prog=`{basename $0}

rfqhub_graph_addr=https://rfqhub.9lives.so

usdc_addr=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
accounts_addr=0x04cDAf344F459E7c0eE86e8088dB603aEc035c86
rpc_url=https://arb1.arbitrum.io/rpc

fn usage {
	echo 'usage:' >[1=2]
	echo '  '$prog' onramp amount [dry-run]' >[1=2]
	echo '  '$prog' taker min-amount max-amount up|down price-target expiry [outcome]' >[1=2]
	echo '  '$prog' auctions' >[1=2]
	echo >[1=2]
	echo 'onramp signs a fresh USDC permit for SPN_SUPERPOSITION_KEY (owner ->' >[1=2]
	echo 'accounts factory as spender) using the on-chain nonce, then submits' >[1=2]
	echo 'onrampAmount to settle USDC into the onramped balance.' >[1=2]
	echo >[1=2]
	echo 'environment:' >[1=2]
	echo '  SPN_SUPERPOSITION_KEY   private key used to derive eoa and sign the permit' >[1=2]
	echo '  SPN_ACCOUNTS_SECRET     account secret for Authorization; or set directly:' >[1=2]
	exit 2
}

fn need {
	if(! which $1 >/dev/null) {
		echo $prog': '$1' not in path' >[1=2]
		exit 1
	}
	true
}

# Send a GraphQL request. Mutations require an Authorization value; the
# auctions query is public. GraphQL errors are printed, non-zero exit.
fn request {
	need curl
	auth=$1
	if(~ $auth '') {
		curl -fsS \
			-H 'Content-Type: application/json' \
			--data-binary @- \
			$rfqhub_graph_addr
	}
	if not {
		curl -fsS \
			-H 'Content-Type: application/json' \
			-H 'Authorization: '$auth \
			--data-binary @- \
			$rfqhub_graph_addr
	}
}

fn render {
	need jq
	jq -e 'if .errors then (.errors | map(.message) | join("\n") | error) else .data end'
}

fn require_auth {
	eoa=`{cast wallet address --private-key $SPN_SUPERPOSITION_KEY}
	if(~ $SPN_ACCOUNTS_SECRET '') {
		usage
	}
	auth=$eoa:$SPN_ACCOUNTS_SECRET
	true
}

# Print a fresh USDC permit JSON {v,r,s,deadline} signing the owner's USDC
# allowance to the accounts factory, using the on-chain nonce and a one-hour
# deadline. Output is a single compact JSON object on stdout.
fn make_permit {
	need cast
	need make-permit
	require_auth
	if(~ $SPN_SUPERPOSITION_KEY '') {
		echo $prog': SPN_SUPERPOSITION_KEY unset (needed to sign the permit)' >[1=2]
		exit 2
	}
	nonce=`{cast call --rpc-url $rpc_url $usdc_addr 'nonces(address)(uint256)' $eoa}
	if(~ $nonce '') {
		echo $prog': failed to read USDC nonce for '$eoa >[1=2]
		exit 1
	}
	now=`{date +%s}
	deadline=`{echo $now + 3600 | bc}
	# make-permit PRIVKEY SPENDER NONCE TOKEN DEADLINE -> {v,r,s}. Combine with
	# the deadline without ever storing the JSON in a shell word (avoids rc
	# command-substitution word-splitting); jq -s slurps {permit, deadline}.
	{
		make-permit $SPN_SUPERPOSITION_KEY $accounts_addr $nonce $usdc_addr $deadline
		echo $deadline
	} | jq -sc '.[0] + {deadline: (.[1] | tonumber)}'
}

fn onramp {
	need jq
	need curl
	need cast
	need make-permit
	require_auth

	if(~ $#* 0)
		usage

	amt=$1
	shift
	dryrun=false
	switch($#*) {
	case 0
	case 1
		if(! ~ $1 dry-run)
			usage
		dryrun=true
	case *
		usage
	}

	make_permit | jq -c \
		--arg query 'mutation Onramp($amt: String!, $permit: Permit!, $dryrun: Boolean) { onrampAmount(amt: $amt, permit: $permit, isDryrun: $dryrun) }' \
		--arg amt $amt \
		--argjson dryrun $dryrun \
		'{query: $query, variables: {amt: $amt, permit: {deadline: .deadline, permitV: .v, permitR: .r, permitS: .s}, dryrun: $dryrun}}' \
		| request $auth
}

fn taker {
	need jq
	require_auth
	if(! ~ $#* 5 6)
		usage

	minamount=$1
	maxamount=$2
	direction=$3
	pricetarget=$4
	expiry=$5
	outcome=BitcoinPrice
	if(~ $#* 6)
		outcome=$6

	switch($direction) {
	case up true
		isup=true
	case down false
		isup=false
	case *
		usage
	}

	jq -cn \
		--arg query 'mutation CreateTaker($minAmount: String!, $maxAmount: String!, $isUp: Boolean!, $priceTarget: String!, $outcome: Outcome!, $expiry: Int!) { createAuctionFromOnrampedAmountServerSig(minAmount: $minAmount, maxAmount: $maxAmount, isUp: $isUp, priceTarget: $priceTarget, outcome: $outcome, expiry: $expiry) { leftoverBal amountSpent bundleId } }' \
		--arg minamount $minamount \
		--arg maxamount $maxamount \
		--argjson isup $isup \
		--arg pricetarget $pricetarget \
		--arg outcome $outcome \
		--arg expiry $expiry \
		'{query: $query, variables: {minAmount: $minamount, maxAmount: $maxamount, isUp: $isup, priceTarget: $pricetarget, outcome: $outcome, expiry: ($expiry | tonumber)}}' \
		| request $auth \
		| render
}

fn auctions {
	need jq
	if(! ~ $#* 0)
		usage

	jq -cn \
		--arg query 'query OpenAuctions { openAuctions { openAuctions { id openToBeWon accAddr deadlineTs outcome expiryTs priceTarget isUp bundleTakerId } } }' \
		'{query: $query}' \
		| request '' \
		| render
}

switch($1) {
case onramp
	shift
	onramp $*
case taker taker-bundle
	shift
	taker $*
case auctions open-auctions
	shift
	auctions $*
case help -h --help ''
	usage
case *
	usage
}

#!/usr/bin/env -S rc -e

prog=`{basename $0}

rfqhub_graph_addr=https://rfqhub.9lives.so

usdc_addr=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
accounts_addr=0xeC9932f0862a7AFd26E258fDFE1201271ae3C3Aa
rpc_url=https://arb1.arbitrum.io/rpc

fn usage {
	echo 'usage:' >[1=2]
	echo '  '$prog' onramp amount [dry-run]' >[1=2]
	echo '  '$prog' taker min-amount max-amount up|down price-target expiry min-offer deadline' >[1=2]
	echo '  '$prog' maker bundle-taker-id min-amount max-amount' >[1=2]
	echo '  '$prog' auctions' >[1=2]
	echo >[1=2]
	echo 'onramp funds the rfqhub (owner ->' >[1=2]
	echo 'accounts factory as spender) using the on-chain nonce, then submits' >[1=2]
	echo 'onrampAmount to settle USDC into the onramped balance.' >[1=2]
	echo >[1=2]
	echo 'environment:' >[1=2]
	echo '  SPN_SUPERPOSITION_KEY   private key used to derive eoa and sign the permit' >[1=2]
	echo '  SPN_ACCOUNTS_SECRET     account secret for Authorization; or set directly:' >[1=2]
	exit 2
}

fn need {
	if(! which $1 >/dev/null) {
		echo $prog': '$1' not in path' >[1=2]
		exit 1
	}
	true
}

# Send a GraphQL request. Mutations require an Authorization value; the
# auctions query is public. GraphQL errors are printed, non-zero exit.
fn request {
	need curl
	auth=$1
	if(~ $auth '') {
		curl -fsS \
			-H 'Content-Type: application/json' \
			--data-binary @- \
			$rfqhub_graph_addr
	}
	if not {
		curl -fsS \
			-H 'Content-Type: application/json' \
			-H 'Authorization: '$auth \
			--data-binary @- \
			$rfqhub_graph_addr
	}
}

fn render {
	need jq
	jq -e 'if .errors then (.errors | map(.message) | join("\n") | error) else .data end'
}

fn require_auth {
	eoa=`{cast wallet address --private-key $SPN_SUPERPOSITION_KEY}
	if(~ $SPN_ACCOUNTS_SECRET '') {
		usage
	}
	auth=$eoa:$SPN_ACCOUNTS_SECRET
	true
}

fn onramp {
	need jq
	need curl
	need cast
	require_auth

	if(~ $#* 0)
		usage

	amt=$1
	shift
	dryrun=false
	switch($#*) {
	case 0
	case 1
		if(! ~ $1 dry-run)
			usage
		dryrun=true
	case *
		usage
	}

	jq -cn \
		--arg query 'mutation Onramp($amt: String!, $dryrun: Boolean) { onrampAmount(amt: $amt, isDryrun: $dryrun) }' \
		--arg amt $amt \
		--argjson dryrun $dryrun \
		'{query: $query, variables: {amt: $amt, dryrun: $dryrun}}' \
		| request $auth \
		| render
}

fn taker {
	need jq
	require_auth
	if(! ~ $#* 7)
		usage

	minamount=$1
	maxamount=$2
	direction=$3
	pricetarget=$4
	expiry=$5
	min_offer=$6
	deadline=$7
	outcome=BitcoinPrice

	switch($direction) {
	case up true
		isup=true
	case down false
		isup=false
	case *
		usage
	}

	jq -cn \
		--arg query 'mutation CreateTaker($minAmount: String!, $maxAmount: String!, $isUp: Boolean!, $priceTarget: String!, $outcome: Outcome!, $expiry: Int!, $minOffer: String!, $deadline: Int!) { createAuctionServerSig(minAmount: $minAmount, maxAmount: $maxAmount, isUp: $isUp, priceTarget: $priceTarget, outcome: $outcome, expiry: $expiry, minOffer: $minOffer, deadline: $deadline) { leftoverBal amountSpent bundleId } }' \
		--arg minamount $minamount \
		--arg maxamount $maxamount \
		--argjson isup $isup \
		--arg pricetarget $pricetarget \
		--arg outcome $outcome \
		--arg expiry $expiry \
		--arg minOffer $min_offer \
		--arg deadline $deadline \
		'{query: $query, variables: {minAmount: $minamount, maxAmount: $maxamount, isUp: $isup, priceTarget: $pricetarget, outcome: $outcome, expiry: ($expiry | tonumber), minOffer: $minOffer, deadline: $deadline}}' \
		| request $auth \
		| render
}

fn maker {
	need jq
	require_auth
	if(! ~ $#* 3)
		usage

	bundletakerid=$1
	minamount=$2
	maxamount=$3

	jq -cn \
		--arg query 'mutation SubmitMaker($bundleTakerId: Int!, $minAmount: String!, $maxAmount: String!) { submitBundleMakerFromOnrampedAmountServerSig(bundleTakerId: $bundleTakerId, minAmount: $minAmount, maxAmount: $maxAmount) { id bundleMakerId } }' \
		--arg bundletakerid $bundletakerid \
		--arg minamount $minamount \
		--arg maxamount $maxamount \
		'{query: $query, variables: {bundleTakerId: ($bundletakerid | tonumber), minAmount: $minamount, maxAmount: $maxamount}}' \
		| request $auth \
		| render
}

fn auctions {
	need jq
	if(! ~ $#* 0)
		usage

	jq -cn \
		--arg query 'query OpenAuctions { openAuctions { openAuctions { id openToBeWon accAddr deadlineTs outcome expiryTs priceTarget isUp bundleTakerId } } }' \
		'{query: $query}' \
		| request '' \
		| render
}

switch($1) {
case onramp
	shift
	onramp $*
case taker taker-bundle
	shift
	taker $*
case maker maker-bundle
	shift
	maker $*
case auctions open-auctions
	shift
	auctions $*
case help -h --help ''
	usage
case *
	usage
}

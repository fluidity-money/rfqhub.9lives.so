
type Query {
  balance(addr: String!): String!
}

input CreateAccount {
  eoa_addr: String!,
  sigV: Int!,
  sigR: String!,
  sigS: String!
  authority: String,
}

input OnrampingFromBal {
  """
  Amount that we're onramping from the owner's address here.
  """
  amt: String!,

  """
  The timestamp when this was submitted to prevent nonce reuse.
  """
  msTs: String!
}

type Mutation {
  """
  Create an account while onramping from bal to create a balance object.
  """
  createAccountExec(
    createAccount: CreateAccount!,
    onrampingFromBal: OnrampingFromBal!
  ): Boolean!
}

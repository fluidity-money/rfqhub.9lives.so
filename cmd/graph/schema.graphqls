
enum Outcome {
    BitcoinPrice,
}

type OpenAuction {
  id: ID!,

  """
  Open to be won if this user is predicting incorrectly.
  """
  openToBeWon: String!,

  """
  Owner's acc addr.
  """
  accAddr: String!,

  """
  Timestamp for then this bundle is considered unfilled if no-one applies with an ask.
  """
  deadlineTs: Int!,

  """
  Outcome that's being predicted against.
  """
  outcome: Outcome!,

  """
  Expiry for when this is considered safe to execute.
  """
  expiryTs: Int!,

  """
  Price target denominated as a integer.
  """
  priceTarget: String!,

  """
  Whether this position predicted that the outcome would go up or down.
  """
  isUp: Boolean!

  """
  ID that lets you address this bundle when making a request.
  """
  bundleTakerId: Int!
}

type OpenAuctions {
  id: ID!,
  openAuctions: [OpenAuction!]!
}

type Query {
  """
  Get the balance that can be spent after it was onramped.
  """
  balance(addr: String!): String!

  """
  Currently outstanding auctions that need a user to submit BundleMakers.
  """
  openAuctions: OpenAuctions!
}

input CreateAccount {
  eoa_addr: String!,
  sigV: Int!,
  sigR: String!,
  sigS: String!
  authority: String,
}

input Permit {
  deadline: Int!,
  permitV: Int!,
  permitR: String!,
  permitS: String!
}

type AuctionCreatedResult {
  """
  Leftover amount that can still be spent by this user.
  """
  leftoverBal: String!,

  """
  The amount that was spent in the creation of this auction.
  """
  amountSpent: String!,

  """
  The BundleTaker identifier for use soon.
  """
  bundleId: Int!
}

type BundleMakerInfo {
  id: ID!,

  """
  The Identifier for the BundleMaker that we can refer to later to determine if it will be
  included. Maker offers cannot be cancelled.
  """
  bundleMakerId: Int!
}

type BundleTakerOwnerStatus {
  id: ID!,

  """
  Was this BundleTaker matched to anyone?
  """
  concluded: Boolean!,

  """
  Was this BundleTaker cancelled?
  """
  cancelled: Boolean!,

  """
  The amount earned from the BundleTaker being matched with a BundleMaker, if any.
  """
  earned: String
}

type Aggregate {
  id: ID!,

  takerWon: Boolean!,

  """
  Amount that the winner won.
  """
  winningAmount: String!
}

type Mutation {
  """
  Create an account while onramping from bal to create a balance object.
  """
  createAccountExec(
    createAccount: CreateAccount!,
    permit: Permit,
    amt: String!,
    isDryrun: Boolean
  ): Boolean!

  """
  Onramp an amount using the router.
  """
  onrampAmount(amt: String!, permit: Permit, isDryrun: Boolean): String!,

  """
  Create an BundleTaker auction, and starting to receive BundleMaker combinations. Use the
  server provided signature for an account that's managed by the server instead of
  validating a signature and an amount. Optimistically uses the amount that's available from
  the onramped amount, and any amount that it must needs to access to get funds.
  """
  createAuctionServerSig(
    """
    The minimum amount of the outstanding balance we can spend here.
    """
    minAmount: String!,

    """"
    The maximum amount to take from the available onramped liquidity.
    """
    maxAmount: String!

    isUp: Boolean!,

    """
    Price target that this is up or down for.
    """
    priceTarget: String!,

    outcome: Outcome!,

    """
    The timestamp that we use for expiry of the market.
    """
    expiry: Int!,

    """
    Deadline for any offers coming in. Orders can only be placed before this ends.
    """
    deadline: Int!,

    """
    Minimum offer of amount to take from the Maker in exchange for this liquidity.
    Null if we're preferring a decay strategy ran by the system.
    """
    minOffer: String,
  ): AuctionCreatedResult!

  """
  Get status that's relevant for the submitter of the BundleTaker. The only caller is the
  owner of the Bundle. Atomic in that the function that inspects information on this is
  the acc_addr that we filter for.
  """
  inspectBundleTakerId(bundleTakerId: Int!): BundleTakerOwnerStatus!

  """
  Conclude a bundle that's been outstanding to be resolved (the expiry date has passed).
  Anyone can call this. `produceOfframpCdTaker` needs to be called by the taker and
  `produceOfframpCdMaker` needs to be called by the maker to get calldata to offramp,
  and also to offramp.
  """
  conclude(bundleTakerId: Int!): Aggregate!

  """
  Get the calldata to perform an offramping from the Rfqhub engine. Marks the aggregate
  bundle as being unable to be consumed.
  """
  concludedCalldata(bundleTakerId: Int!, isTaker: Boolean!): String!

  """
  Cancel an auction, using the taker id to do so. Only possible to be invoked by the
  creator of the auction. It's only possible to cancel the auction if it's within the
  one minute window of the market existing.
  """
  cancelAuction(bundleTakerId: Int!): Boolean!

  """
  Submit a BundleMaker. The BundleMaker is not necessarily consumed unless it's chosen at
  the end of the BundleTaker's life by the server or by the end user, depending on the
  Taker's strategy for choosing. The BundleMaker here will take the opposite position of
  the BundleTaker.
  """
  submitBundleMakerServerSig(
    """
    The bundle taker to point to to make this interaction work.
    """
    bundleTakerId: Int!,

    """
    The minimum amount of the outstanding balance we can spend here.
    """
    minAmount: String!,

    """"
    The maximum amount to take from the available onramped liquidity.
    """
    maxAmount: String!
  ): BundleMakerInfo!
}

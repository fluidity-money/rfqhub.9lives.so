
enum Outcome {
    BitcoinPrice,
}

type Query {
  """
  Get the balance that can be spent after it was onramped.
  """
  balance(addr: String!): String!
}

input CreateAccount {
  eoa_addr: String!,
  sigV: Int!,
  sigR: String!,
  sigS: String!
  authority: String,
}

input Permit {
  deadline: Int!,
  permitV: Int!,
  permitR: String!,
  permitS: String!
}

type AuctionResult {
  """
  Leftover amount that can be spent by this user.
  """
  leftoverBal: String!,

  """
  The amount that was spent in the creation of this auction.
  """
  amountSpent: String!,
}

type Mutation {
  """
  Create an account while onramping from bal to create a balance object.
  """
  createAccountExec(
    createAccount: CreateAccount!,
    permit: Permit,
    amt: String!,
    isDryrun: Boolean
  ): Boolean!

  """
  Onramp some funds from the owner of this account.
  """
  onrampAmount(amt: String!): Boolean!

  """
  Create an auction for a taker position, returning the amount that was spent, and the
  leftover balance. The server will start to find makers to append to the taker position,
  selecting the one that offers the best amount.
  """
  createAuction(
    """
    The minimum amount of the outstanding balance we can spend here.
    """
    minAmount: String!,

    isUp: Boolean!,

    priceTarget: String!,

    outcome: Outcome!,

    """
    The timestamp that we use for expiry of the market.
    """
    expiry: String!
  ): AuctionResult!
}


type Query {
  balance(addr: String!): String!
}

type Mutation {
  """
  Use the same secret as the accounts server to create a statement for the spendable
  amount if the balance is enough, then use that amount to create an internal object for
  spending that can be accessed to be used to create a recursive RFQ blob. Currently,
  rfqhub is needed to sign off on any pairs that are created to prevent any potential for
  abuse. This weakness stems from trying to keep the system lean by not doing any
  historical calculation for the best result from the RFQ matching, instead preferring
  to expire the amount if noone matches. Any RFQ engine matchers should use the
  model to backstop poor liquidity.

  The secret in-browser blob needs to be sent with the Authorization header.
  """
  createRfqV1(
    """
    The asset that this prediction is for.
    """
    quoteAsset: String!,
    """
    The deadline for when this option should expire.
    """
    deadline: String!,

    """
    The amount that's being staked on the outcome of the market.
    """
    fromAmt: String!
  ): String!
}

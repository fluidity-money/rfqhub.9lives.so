
FROM golang:alpine3.24 AS build-go

WORKDIR /usr/src/rfqhub.9lives.so

COPY go.mod go.mod
COPY go.sum go.sum

RUN go get ./...

COPY lib/ lib/
COPY cmd/ cmd/

RUN cd cmd/conclude-crank && go build -o ../../rfqhub-conclude-crank

FROM alpine:3.24 AS runner

COPY --from=build-go \
	/usr/src/rfqhub.9lives.so/rfqhub-conclude-crank \
	/bin/rfqhub-conclude-crank

ENTRYPOINT ["/bin/rfqhub-websocket"]
